sub=rep(1:I,each=J*K*L)
task=rep(rep(1:J,each=K*L),I)
cond=rep(rep(1:K,each=L),I*J)
dat=data.frame(sub,cond,task)
return(dat)}
makeTruth=function(dat){
I=max(dat$sub)
J=max(dat$task)
tAlpha=rmvnorm(I,c(0,0),matrix(c(.1,.07,.07,.1),ncol=2))
tTheta=rmvnorm(I,c(.5,.5),matrix(c(.5,.025,.025,.5),ncol=2))
return(list(
"tAlpha"=tAlpha,
"tTheta"=tTheta))}
addData=function(dat,truth){
N=length(dat$sub)
center=truth$tAlpha[cbind(dat$sub,dat$cond)]+
(dat$cond-1.5)*truth$tTheta[cbind(dat$sub,dat$cond)]
dat$p=plogis(center)
dat$y=rbern(N,plogis(center))
return(dat)
}
